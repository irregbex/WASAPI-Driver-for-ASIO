; Neutral Spanish (Latin America friendly). The legal texts shown by the installer stay in English.
LangString L_NOTICES_TITLE ${LANG_SPANISH} "Avisos"
LangString L_NOTICES_SUB ${LANG_SPANISH} "Marcas, resumen de la licencia y notas de seguridad (en inglés)."
LangString L_NEED64 ${LANG_SPANISH} "${NAME} requiere Windows de 64 bits (x64 o ARM64)."
LangString L_REMOVING_OLD ${LANG_SPANISH} "Quitando la versión anterior (${OLDNAME}) de"
LangString L_ARM64_Q ${LANG_SPANISH} "Se detectó Windows en ARM64.$\r$\n$\r$\nSí = la DAW es ARM64 nativa$\r$\nNo = la DAW es x64 (emulada)"
LangString L_REG_ARM64 ${LANG_SPANISH} "ARM64 registrado (vista de 64 bits)"
LangString L_REG_X64 ${LANG_SPANISH} "x64 registrado (vista de 64 bits)"
LangString L_REG_X86 ${LANG_SPANISH} "x86 registrado (vista de 32 bits)"
LangString L_WELCOME_TEXT ${LANG_SPANISH} "El programa instala ${NAME} ${VERSION}: un driver ASIO para cualquier dispositivo de audio de Windows (WASAPI Compartido y Exclusivo).$\r$\n$\r$\nCierra tu DAW antes de continuar.$\r$\n$\r$\n${ATTRIB}"
LangString L_WELCOME_TITLE ${LANG_SPANISH} "${NAME}® ${VERSION}"
; 0.9.6 (KI-2): files in use (WaitFileFree in WasapiDriver.nsi)
LangString L_INUSE_LOG ${LANG_SPANISH} "En uso:"
LangString L_INUSE_HEAD ${LANG_SPANISH} "Este archivo de ${NAME} está en uso, así que el programa de instalación no puede reemplazarlo:"
LangString L_UN_INUSE_HEAD ${LANG_SPANISH} "Este archivo de ${NAME} está en uso, así que no se puede quitar:"
LangString L_INUSE_CLOSE ${LANG_SPANISH} "Cierra tus programas de audio (Cubase, DaVinci Resolve, Ableton Live, otras DAW y editores de audio, y la herramienta de diagnóstico o de prueba del driver) y haz clic en Reintentar.$\r$\nSi un programa sigue en el Administrador de tareas después de cerrarlo, finalízalo allí (Administrador de tareas > selecciónalo > Finalizar tarea)."
LangString L_INUSE_CANCEL ${LANG_SPANISH} "Cancelar detiene la instalación. Todavía no se ha cambiado nada."
LangString L_UN_INUSE_CANCEL ${LANG_SPANISH} "Cancelar detiene la desinstalación. Todavía no se ha quitado nada."
